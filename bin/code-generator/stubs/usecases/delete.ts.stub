import { Inject } from '@nestjs/common';
import { {{pascalCase}}Model } from '@entities/{{kebabCase}}.model';
import { I{{pascalCase}}Repository } from '@usecases/{{kebabCase}}/repository.interface';

export class Delete{{pascalCase}} {
  constructor(
    @Inject('{{modelCamel}}Repository')
    private {{modelCamel}}Repository: I{{pascalCase}}Repository,
  ) {}

  async execute(id: string): Promise<{{pascalCase}}Model> {
    const currentModel = await this.{{modelCamel}}Repository.findOne({ _id: id });

    if (!currentModel) {
      throw new Error('item not found');
    }

    return await this.{{modelCamel}}Repository.delete(id);
  }
}
