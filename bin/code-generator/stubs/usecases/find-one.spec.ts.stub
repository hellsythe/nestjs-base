import { I{{pascalCase}}Repository } from '@usecases/{{kebabCase}}/repository.interface';
import { FindOne } from './find-one';
import { TestBed } from '@automock/jest';
import { createFake{{pascalCase}} } from '@test/factory/{{kebabCase}}.factory';
import { {{pascalCase}}Model } from '@entities/{{kebabCase}}.model';

describe('find {{modelCamel}}', () => {
  let findOne: FindOne;
  let {{modelCamel}}Repository: jest.Mocked<I{{pascalCase}}Repository>;

  beforeAll(async () => {
    const { unit, unitRef } = TestBed.create(FindOne).compile();
    findOne = unit;
    {{modelCamel}}Repository = unitRef.get('{{modelCamel}}Repository');
  });

  test('Success', async () => {
    const {{modelCamel}}Fake: {{pascalCase}}Model = createFake{{pascalCase}}();
    {{modelCamel}}Repository.findOne.mockResolvedValue({{modelCamel}}Fake);

    const found{{pascalCase}} = await findOne.execute({ {{property}}: {{modelCamel}}Fake.{{property}} });

    expect(found{{pascalCase}}.{{property}}).toEqual({{modelCamel}}Fake.{{property}});
    expect({{modelCamel}}Repository.findOne).toHaveBeenCalledWith({
      {{property}}: {{modelCamel}}Fake.{{property}},
    });
  });
});
