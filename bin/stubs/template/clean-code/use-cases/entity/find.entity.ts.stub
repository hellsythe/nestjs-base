import { Inject } from '@nestjs/common';
import { {{pascalCase}}Model } from '@entities/{{kebabCase}}.model';
import { I{{pascalCase}}Repository } from '@usecases/{{kebabCase}}/{{kebabCase}}.repository.interface';

export class FindAll{{pascalCase}} {
  searchOptions: Array<string> = ['name', 'namespace', 'language', 'waba'];
  constructor(
    @Inject('{{camelCase}}Repository')
    private {{camelCase}}Repository: I{{pascalCase}}Repository,
  ) {}

  async execute(query: any): Promise<Array<{{pascalCase}}Model>> {
    this.clearQuery(query);

    return await this.{{camelCase}}Repository.find(query);
  }

  private clearQuery(query: any): void {
    Object.keys(query).forEach((key) => {
      if (!this.searchOptions.includes(key)) {
        delete query[key];
      }
    });
  }
}
