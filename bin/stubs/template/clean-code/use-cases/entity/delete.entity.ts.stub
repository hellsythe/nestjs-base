import { Inject } from '@nestjs/common';
import { {{pascalCase}}Model } from '@entities/{{kebabCase}}.model';
import { I{{pascalCase}}Repository } from '@usecases/{{kebabCase}}/{{kebabCase}}.repository.interface';

export class Delete{{pascalCase}} {
  constructor(
    @Inject('{{camelCase}}Repository')
    private {{camelCase}}Repository: I{{pascalCase}}Repository,
  ) {}

  async execute(id: string): Promise<{{pascalCase}}Model> {
    const currentModel = await this.{{camelCase}}Repository.findOne({ _id: id });

    if (!currentModel) {
      throw new Error('item not found');
