import { {{pascalCase}}Model } from '@entities/{{kebabCase}}.model';
import { createFake{{pascalCase}} } from '@test/factory/{{kebabCase}}.factory';
import { Delete{{pascalCase}} } from './delete.{{kebabCase}}';
import { TestBed } from '@automock/jest';
import { I{{pascalCase}}Repository } from '@usecases/{{kebabCase}}/{{kebabCase}}.repository.interface';
import { NotFoundException } from '@nestjs/common';

describe('delete{{pascalCase}}', () => {
  let delete{{pascalCase}}: Delete{{pascalCase}};
  let {{camelCase}}Repository: jest.Mocked<I{{pascalCase}}Repository>;

  beforeAll(async () => {
    const { unit, unitRef } = TestBed.create(Delete{{pascalCase}}).compile();
    delete{{pascalCase}} = unit;
    {{camelCase}}Repository = unitRef.get('{{camelCase}}Repository');
  });

  test('delete{{pascalCase}}', async () => {
    const {{camelCase}}Fake: {{pascalCase}}Model = createFake{{pascalCase}}();
    {{camelCase}}Repository.findOne.mockResolvedValueOnce({{camelCase}}Fake);
    {{camelCase}}Repository.delete.mockResolvedValueOnce({{camelCase}}Fake);

    await delete{{pascalCase}}.execute('fakeId');

    expect({{camelCase}}Repository.delete).toHaveBeenCalledWith('fakeId');
  });

  test('delete{{pascalCase}}Fail', async () => {
    const {{camelCase}}Fake: {{pascalCase}}Model = createFake{{pascalCase}}();
    {{camelCase}}Repository.findOne.mockResolvedValueOnce(null);
    {{camelCase}}Repository.delete.mockResolvedValueOnce({{camelCase}}Fake);

    await expect(async () => {
      await delete{{pascalCase}}.execute('fakeId');
    }).rejects.toThrow(new NotFoundException('item not found'));
  });
});
