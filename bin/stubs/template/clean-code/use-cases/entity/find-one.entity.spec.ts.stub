    {{camelCase}}Repository = unitRef.get('{{camelCase}}Repository');
  });

  test('Success', async () => {
    const {{camelCase}}Fake: {{pascalCase}}Model = createFake{{pascalCase}}();
    {{camelCase}}Repository.findOne.mockResolvedValue({{camelCase}}Fake);

