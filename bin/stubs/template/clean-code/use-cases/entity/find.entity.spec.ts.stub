import { I{{pascalCase}}Repository } from '@usecases/{{kebabCase}}/{{kebabCase}}.repository.interface';
import { FindAll{{pascalCase}} } from './find.{{kebabCase}}';
import { TestBed } from '@automock/jest';
import { createFake{{pascalCase}} } from '@test/factory/{{kebabCase}}.factory';
import { {{pascalCase}}Model } from '@entities/{{kebabCase}}.model';

describe('find {{camelCase}}', () => {
  let find: FindAll{{pascalCase}};
  let {{camelCase}}Repository: jest.Mocked<I{{pascalCase}}Repository>;

